# Скопируй в .env рядом с docker-compose.yml: cp .env.example .env
# Этот файл читает docker compose; backend/.env для контейнеров больше не нужен.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=restaurant_db
MYSQL_USER=restaurant
MYSQL_PASSWORD=change-me

# --- Backend ---
SECRET_KEY=change-me-to-a-long-random-string
# URL, который попадает в письма (верификация почты, сброс пароля).
# Прод: адрес nginx-контейнера. Dev-оверрайд подменяет на http://localhost:3000
FRONTEND_URL=http://localhost:8080
# Прогонять alembic upgrade head при старте контейнера
RUN_MIGRATIONS=true

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
FROM_EMAIL=noreply@yourapp.com

# --- Порты на хосте ---
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=3000
BACKEND_PORT=8000
DB_PORT=3307

# --- Сборка фронта ---
# Относительный путь: браузер бьёт в тот же origin, nginx проксирует на backend:8000
REACT_APP_API_URL=/api
